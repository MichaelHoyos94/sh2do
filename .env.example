# Valores de desarrollo local. Copia este archivo a .env (up.ps1 lo hace si falta).
# En cualquier otro entorno, cambia TODAS las contraseñas y JWT_SECRET.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

MYSQL_ROOT_PASSWORD=sh2do_root_dev
MYSQL_DATABASE=sh2do
MYSQL_USER=sh2do
MYSQL_PASSWORD=sh2do_dev
DATABASE_URL=mysql://sh2do:sh2do_dev@mysql:3306/sh2do
DATABASE_URL_TEST=mysql://sh2do:sh2do_dev@mysql:3306/sh2do_test

REDIS_URL=redis://redis:6379

# Mínimo 32 caracteres
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
COOKIE_SECURE=false

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sh2do <no-reply@sh2do.local>
