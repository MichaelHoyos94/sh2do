// Fiel a docs/sh2do-model.json. Solo las tablas que usan STD-6, STD-7 y STD-8; las demás las añade su feature.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum EmailKind {
  verify_email
  reset_password
  password_changed
  reminder
  plan_updated
  plan_cancelled
}

enum TaskPriority {
  low
  medium
  high
}

enum OccurrenceStatus {
  pending
  in_progress
  completed
}

enum EmailStatus {
  queued
  accepted
  failed
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(100)
  emailVerifiedAt DateTime? @map("email_verified_at")
  timezone        String    @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            UserSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  emailDeliveries     EmailDelivery[]
  tasks               Task[]

  @@index([emailVerifiedAt], map: "idx_users_verified")
  @@map("users")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expiry")
  @@map("user_sessions")
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_email_tokens_user")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_reset_tokens_user")
  @@map("password_reset_tokens")
}

model EmailDelivery {
  id                Int         @id @default(autoincrement())
  userId            Int         @map("user_id")
  // Sin relación hasta que exista `notifications` (STD-16 añade la FK).
  notificationId    Int?        @map("notification_id")
  kind              EmailKind
  recipientEmail    String      @map("recipient_email") @db.VarChar(254)
  dedupeKey         String      @unique @map("dedupe_key") @db.VarChar(160)
  status            EmailStatus @default(queued)
  attemptCount      Int         @default(0) @map("attempt_count")
  providerMessageId String?     @map("provider_message_id") @db.VarChar(200)
  lastError         String?     @map("last_error") @db.Text
  createdAt         DateTime    @default(now()) @map("created_at")
  processedAt       DateTime?   @map("processed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt], map: "idx_email_deliveries_status")
  @@index([userId], map: "idx_email_deliveries_user")
  @@map("email_deliveries")
}

model Task {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  title       String       @db.VarChar(200)
  description String?      @db.Text
  priority    TaskPriority @default(medium)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // RESTRICT hasta que exista el borrado de cuenta (mismo criterio que el resto de FK hacia users).
  user        User             @relation(fields: [userId], references: [id])
  occurrences TaskOccurrence[]

  @@index([userId], map: "idx_tasks_owner")
  @@map("tasks")
}

model TaskOccurrence {
  id                  Int              @id @default(autoincrement())
  taskId              Int              @map("task_id")
  // Sin relación hasta que exista recurrence_rules (STD-12 añade la FK con ON DELETE SET NULL).
  recurrenceRuleId    Int?             @map("recurrence_rule_id")
  sequenceNo          Int              @map("sequence_no")
  originalDate        DateTime?        @map("original_date") @db.Date
  scheduledDate       DateTime?        @map("scheduled_date") @db.Date
  scheduledTime       DateTime?        @map("scheduled_time") @db.Time(0)
  timezone            String           @db.VarChar(64)
  scheduledAtUtc      DateTime?        @map("scheduled_at_utc")
  status              OccurrenceStatus @default(pending)
  titleOverride       String?          @map("title_override") @db.VarChar(200)
  descriptionOverride String?          @map("description_override") @db.Text
  priorityOverride    TaskPriority?    @map("priority_override")
  remindersOverridden Boolean          @default(false) @map("reminders_overridden")
  completedAt         DateTime?        @map("completed_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, sequenceNo], map: "uq_task_occ_sequence")
  @@index([scheduledDate, status], map: "idx_occ_user_calendar")
  @@index([recurrenceRuleId], map: "idx_occ_rule")
  @@index([scheduledAtUtc], map: "idx_occ_due")
  @@map("task_occurrences")
}
